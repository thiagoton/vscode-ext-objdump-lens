{
  "name": "objdump-lens",
  "displayName": "Objdump Lens - Syntax highlight/ASM folding",
  "description": "Syntax highlighting, C/C++ vs asm separation, per-source-line asm folding and Compiler Explorer opcode tooltips for objdump -S / .lss listings.",
  "version": "0.3.0",
  "publisher": "thiagoton",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "objdump",
    "disassembly",
    "assembly",
    "arm",
    "cortex-m",
    "embedded",
    "lss",
    "fold"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:disasm"
  ],
  "scripts": {
    "test": "node test/parser.test.js && node test/grammar.test.js && node test/docs.test.js && node test/extension.smoke.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "disasm",
        "aliases": [
          "Disassembly (objdump -S)",
          "disasm"
        ],
        "extensions": [
          ".disasm",
          ".dasm",
          ".dis",
          ".objdump",
          ".lss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "disasm",
        "scopeName": "source.disasm",
        "path": "./syntaxes/disasm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "objdumpLens.collapseAllAsm",
        "title": "Collapse All Assembly Blocks",
        "category": "Objdump Lens",
        "icon": "$(fold)"
      },
      {
        "command": "objdumpLens.expandAllAsm",
        "title": "Expand All Assembly Blocks",
        "category": "Objdump Lens",
        "icon": "$(unfold)"
      },
      {
        "command": "objdumpLens.toggleAllAsm",
        "title": "Toggle All Assembly Blocks",
        "category": "Objdump Lens"
      },
      {
        "command": "objdumpLens.toggleAsmAtCursor",
        "title": "Toggle Assembly Block at Cursor",
        "category": "Objdump Lens"
      },
      {
        "command": "objdumpLens.collapseFunctionAsm",
        "title": "Collapse Assembly Blocks in Current Function",
        "category": "Objdump Lens"
      },
      {
        "command": "objdumpLens.expandFunctionAsm",
        "title": "Expand Assembly Blocks in Current Function",
        "category": "Objdump Lens"
      },
      {
        "command": "objdumpLens.selectArchitecture",
        "title": "Select Architecture for This File (opcode docs)",
        "category": "Objdump Lens"
      },
      {
        "command": "objdumpLens.clearDocCache",
        "title": "Clear Opcode Documentation Cache",
        "category": "Objdump Lens"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "objdumpLens.collapseAllAsm",
          "when": "resourceLangId == disasm",
          "group": "navigation@1"
        },
        {
          "command": "objdumpLens.expandAllAsm",
          "when": "resourceLangId == disasm",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "objdumpLens.toggleAsmAtCursor",
          "when": "editorLangId == disasm",
          "group": "objdumpLens@1"
        },
        {
          "command": "objdumpLens.collapseFunctionAsm",
          "when": "editorLangId == disasm",
          "group": "objdumpLens@2"
        },
        {
          "command": "objdumpLens.expandFunctionAsm",
          "when": "editorLangId == disasm",
          "group": "objdumpLens@3"
        },
        {
          "command": "objdumpLens.selectArchitecture",
          "when": "editorLangId == disasm",
          "group": "objdumpLens@4"
        }
      ],
      "commandPalette": [
        {
          "command": "objdumpLens.collapseAllAsm",
          "when": "editorLangId == disasm"
        },
        {
          "command": "objdumpLens.expandAllAsm",
          "when": "editorLangId == disasm"
        },
        {
          "command": "objdumpLens.toggleAllAsm",
          "when": "editorLangId == disasm"
        },
        {
          "command": "objdumpLens.toggleAsmAtCursor",
          "when": "editorLangId == disasm"
        },
        {
          "command": "objdumpLens.collapseFunctionAsm",
          "when": "editorLangId == disasm"
        },
        {
          "command": "objdumpLens.expandFunctionAsm",
          "when": "editorLangId == disasm"
        },
        {
          "command": "objdumpLens.selectArchitecture",
          "when": "editorLangId == disasm"
        },
        {
          "command": "objdumpLens.clearDocCache"
        }
      ]
    },
    "configuration": {
      "title": "Objdump Lens",
      "properties": {
        "objdumpLens.decorations": {
          "type": "boolean",
          "default": true,
          "description": "Tint C/C++ source lines, assembly lines and function headers so they are easy to tell apart."
        },
        "objdumpLens.dimEncoding": {
          "type": "boolean",
          "default": true,
          "description": "Dim the address and raw opcode bytes of assembly lines so the mnemonic and operands stand out."
        },
        "objdumpLens.showAsmSummary": {
          "type": "boolean",
          "default": true,
          "description": "Show an instruction count at the end of each C/C++ line that owns an assembly block."
        },
        "objdumpLens.autoCollapseOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Collapse every assembly block when a disassembly file is opened."
        },
        "objdumpLens.documentation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show opcode documentation from Compiler Explorer when hovering over a mnemonic. Only the instruction set and the opcode are sent to the server."
        },
        "objdumpLens.documentation.serverUrl": {
          "type": "string",
          "default": "https://godbolt.org",
          "description": "Base URL of the Compiler Explorer instance used for GET /api/asm/<instructionSet>/<opcode> (point it at a self-hosted instance if you prefer).",
          "scope": "machine-overridable"
        },
        "objdumpLens.documentation.showNotFound": {
          "type": "boolean",
          "default": true,
          "description": "Show a short hover message when Compiler Explorer has no documentation for the opcode."
        },
        "objdumpLens.architecture.default": {
          "type": "string",
          "default": "auto",
          "description": "Instruction set (Compiler Explorer id, e.g. arm32, aarch64, amd64, avr, riscv32) used for opcode docs. \"auto\" detects it from the listing's 'file format' line (e.g. elf32-littlearm -> arm32). A choice made with 'Select Architecture for This File' takes precedence."
        },
        "objdumpLens.architecture.fileAssociations": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Map of glob pattern to instruction set, e.g. `{ \"**/firmware/*.lss\": \"arm32\", \"**/host/*.disasm\": \"amd64\" }`. Patterns are matched against the full file path, so start them with `**/`."
        }
      }
    },
    "colors": [
      {
        "id": "objdumpLens.asmBackground",
        "description": "Background of assembly lines in Objdump Lens.",
        "defaults": {
          "dark": "#4d9cff12",
          "light": "#0b5fff0c",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "objdumpLens.asmBorder",
        "description": "Left marker of assembly lines in Objdump Lens.",
        "defaults": {
          "dark": "#4d9cff80",
          "light": "#0b5fff70",
          "highContrast": "#6fc3ff",
          "highContrastLight": "#0b5fff"
        }
      },
      {
        "id": "objdumpLens.sourceBackground",
        "description": "Background of C/C++ source lines in Objdump Lens.",
        "defaults": {
          "dark": "#3fb9501c",
          "light": "#1a7f3714",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "objdumpLens.sourceBorder",
        "description": "Left marker of C/C++ source lines in Objdump Lens.",
        "defaults": {
          "dark": "#3fb950a0",
          "light": "#1a7f37a0",
          "highContrast": "#7ee787",
          "highContrastLight": "#1a7f37"
        }
      },
      {
        "id": "objdumpLens.functionBackground",
        "description": "Background of function header lines in Objdump Lens.",
        "defaults": {
          "dark": "#d29a2a38",
          "light": "#bf870038",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "objdumpLens.summaryForeground",
        "description": "Color of the instruction count shown after C/C++ lines.",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      }
    ]
  }
}
